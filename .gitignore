# CodeOrigin is a Markdown-first skill collection. This ignore file keeps the
# repository clean of OS, editor, and common build/tooling artifacts that may
# appear when the skills are used or edited inside a larger project.

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor / IDE ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.\#*
\#*\#

# --- Logs & temp ---
*.log
*.tmp
*.temp
*.bak
tmp/
temp/

# --- Node (only if tooling is added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python (only if tooling is added later) ---
__pycache__/
*.py[cod]
.venv/
venv/
.env

# --- Env / secrets (never commit) ---
.env
.env.*
*.pem
*.key
secrets.*
